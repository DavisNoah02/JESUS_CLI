{
  "name": "jesuschrist",
  "version": "0.1.1",
  "description": "Read the Bible in your terminal with a Node.js CLI.",
  "keywords": [
    "bible",
    "kjv",
    "cli",
    "command-line",
    "terminal",
    "scripture",
    "devtools"
  ],
  "homepage": "https://github.com/DavisNoah02/JESUS_CLI#readme",
  "bugs": "https://github.com/DavisNoah02/JESUS_CLI/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavisNoah02/JESUS_CLI.git"
  },
  "license": "MIT",
  "author": "noah_dave <m.davenoa@gmail.com>",
  "type": "module",
  "bin": {
    "jesus": "src/cli.js",
    "jesuschrist": "src/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "start": "node src/cli.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test"
  },
  "files": [
    "src",
    "data",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  }
}
